+package orders
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// LineItem is one SKU on an order, bought Qty times.
+type LineItem struct {
+	SKU string
+	Qty int
+}
+
+// ErrMalformedLineItem is returned for a line item that is not `<sku>:<qty>`.
+var ErrMalformedLineItem = errors.New("orders: line item must be <sku>:<qty>")
+
+// ParseLineItem parses one line item written as `<sku>:<qty>`, e.g. "A-100:3".
+func ParseLineItem(s string) (LineItem, error) {
+	sku, qty, ok := strings.Cut(strings.TrimSpace(s), ":")
+	if !ok || strings.TrimSpace(sku) == "" {
+		return LineItem{}, fmt.Errorf("orders: parse line item %q: %w", s, ErrMalformedLineItem)
+	}
+	n, err := ParseQuantity(qty)
+	if err != nil {
+		return LineItem{}, fmt.Errorf("orders: parse line item %q: %w", s, err)
+	}
+	return LineItem{SKU: strings.TrimSpace(sku), Qty: n}, nil
+}
