+package orders
+
+import (
+	"errors"
+	"strconv"
+	"testing"
+)
+
+func TestParseLineItem(t *testing.T) {
+	cases := []struct {
+		in      string
+		want    LineItem
+		wantErr error
+	}{
+		{"A-100:3", LineItem{SKU: "A-100", Qty: 3}, nil},
+		{" B-7:12 ", LineItem{SKU: "B-7", Qty: 12}, nil},
+		{"A-100", LineItem{}, ErrMalformedLineItem},
+		{":3", LineItem{}, ErrMalformedLineItem},
+		{"A-100:0", LineItem{}, ErrNonPositive},
+		{"A-100:x", LineItem{}, strconv.ErrSyntax},
+	}
+	for _, c := range cases {
+		got, err := ParseLineItem(c.in)
+		if c.wantErr != nil {
+			if !errors.Is(err, c.wantErr) {
+				t.Errorf("ParseLineItem(%q) err = %v, want %v", c.in, err, c.wantErr)
+			}
+			continue
+		}
+		if err != nil || got != c.want {
+			t.Errorf("ParseLineItem(%q) = %+v, %v; want %+v", c.in, got, err, c.want)
+		}
+	}
+}
