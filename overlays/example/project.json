{
  "$schema": "../_schema/project.schema.json",
  "name": "example",
  "displayName": "Example Project",
  "codePath": "/path/to/your/project",
  "monorepo": "apps_root",
  "mainApp": "web-app",
  "apps": ["web-app", "marketing-site", "docs"],
  "repos": ["apps/web-app", "apps/marketing-site", "apps/docs", "infrastructure"],
  "device": "edge-device",
  "domainTerms": {
    "product": "your product domain",
    "device": "your edge device",
    "threatModelExample": "your device"
  },
  "cloud": { "provider": "gcp", "region": "your-region", "runtime": "cloud-run", "envAlias": "staging" },
  "stack": { "web": "Next.js + TypeScript", "db": "PostgreSQL + an ORM" },
  "commitScopes": ["web-app", "marketing-site", "docs", "infra"],
  "enabledPacks": ["iot-pack", "web-pack"],
  "web": {
    "landingRoot": "apps/marketing-site/src",
    "tokensSource": "apps/marketing-site/tailwind.config.ts",
    "palette": { "primary": "--color-brand-primary", "accent": "--color-brand-accent", "surface": "--color-surface" },
    "fonts": { "display": "<display-family>", "body": "<body-family>", "mono": "<mono-family>" },
    "sections": ["Hero", "Problem", "Features", "HowItWorks", "Pricing", "SocialProof", "FAQ", "EmailCapture", "FinalCTA"],
    "audience": "your target buyer, in your own words",
    "conversionGoal": "waitlist email capture",
    "analytics": "src/lib/analytics.ts — track(eventName, props)"
  },
  "jira": {
    "baseUrl": "<jira-base-url>",
    "projectKey": "<PROJECT-KEY>",
    "qaStatus": "QA",
    "repro": { "setup": "npm ci", "test": "npm test" },
    "budget": { "maxFiles": 5, "maxAttempts": 3 }
  }
}
