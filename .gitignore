# Framework repo tracks framework only — never work artifacts.
# Per-project working artifacts live in the sibling swarmery-workspace/ repo (D-G1).
claude-workspace/
swarmery-workspace/

# Generated indexes are regenerated per consumer, not shipped
agents-index.json
skills-index.json

# Local control-plane state (session index), written per machine
.swarmery/

# Temporary / scratch files
temp/

# Tool-local state (Serena project caches, agent scratch memory) — per machine
.serena/
**/.serena/
.claude/agent-memory/

# OS / editor noise
.DS_Store
*.log
node_modules/
.flavor-tokens*
.idea/
.claude/worktrees/
.claude/settings.json.bak
.claude/settings.local.json
.claude/settings.local.json.bak
architecture-out/

# Playwright MCP run artifacts (console logs, page snapshots)
.playwright-mcp/

# design-pack working artifacts (sources, token inventories, diffs) — large, regenerable
.design-verify/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
