#!/usr/bin/env bash
# scripts/git-hooks/post-commit — versioned post-commit hook for this repo.
# Install with: git config core.hooksPath scripts/git-hooks
#
# Thin caller: if the commit touched plugins/, run scripts/sync-cache.sh with
# no flags. Guarded twice: the script refuses on its own outside the primary
# worktree on main, and this hook repeats that check before calling it, so a
# stale (pre-guard) copy of the script in an old worktree can't sync either.
# Override both with SWARMERY_SYNC_CACHE_FORCE=1.
set -euo pipefail

# Captured, not piped into `grep -q`: under pipefail an early-exiting grep can
# SIGPIPE diff-tree and turn a real plugin commit into a silent skip.
changed="$(git diff-tree --root --no-commit-id --name-only -r HEAD -- plugins/)"
[ -n "$changed" ] || exit 0

if [ "${SWARMERY_SYNC_CACHE_FORCE:-0}" != "1" ]; then
  git_dir="$(git rev-parse --path-format=absolute --absolute-git-dir)"
  common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
  branch="$(git rev-parse --abbrev-ref HEAD)"
  if [ "$git_dir" != "$common_dir" ]; then
    echo "post-commit: not syncing plugin caches — this is a linked worktree, not the primary worktree (SWARMERY_SYNC_CACHE_FORCE=1 overrides)." >&2
    exit 0
  fi
  if [ "$branch" != "main" ]; then
    echo "post-commit: not syncing plugin caches — HEAD is on '$branch', not main (SWARMERY_SYNC_CACHE_FORCE=1 overrides)." >&2
    exit 0
  fi
fi

bash "$(git rev-parse --show-toplevel)/scripts/sync-cache.sh"
