{
  "name": "swarmery-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.2.0"
  },
  "scripts": {
    "dev": "npm run i18n:compile && vite",
    "build": "npm run i18n:compile && tsc --noEmit && vite build",
    "lint": "biome lint src",
    "test": "npm run i18n:compile && vitest run",
    "i18n:extract": "node scripts/require-node.mjs && lingui extract --clean",
    "i18n:compile": "node scripts/require-node.mjs && lingui compile",
    "i18n:check": "node scripts/require-node.mjs && lingui extract --clean && lingui compile --strict",
    "preview": "vite preview",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@lingui/core": "6.11.0",
    "@lingui/react": "6.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@biomejs/biome": "^2.6.4",
    "@lingui/babel-plugin-lingui-macro": "6.11.0",
    "@lingui/cli": "6.11.0",
    "@lingui/conf": "6.11.0",
    "@lingui/format-po": "6.11.0",
    "@lingui/vite-plugin": "6.11.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
