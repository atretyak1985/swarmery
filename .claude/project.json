{
  "$schema": "../overlays/_schema/project.schema.json",
  "name": "swarmery",
  "displayName": "Swarmery (framework, self-hosted)",
  "codePath": "/path/to/swarmery",
  "repos": ["plugins/core", "plugins/uav-pack", "plugins/iot-pack", "plugins/web-pack", "plugins/infra-pack", "plugins/lsp-pack", "plugins/design-pack", "scripts", "docs", "evals"],
  "domainTerms": {
    "product": "vendor-neutral Claude Code agent framework (plugin marketplace)"
  },
  "stack": {
    "web": "Markdown agents/skills + Bash hooks + JSON plugin manifests"
  },
  "commitScopes": ["core", "uav-pack", "iot-pack", "web-pack", "infra-pack", "lsp-pack", "design-pack", "marketplace", "docs", "scripts", "evals"],
  "enabledPacks": [],
  "design": {
    "tokensFile": "tools/swarmery/web/src/index.css",
    "componentsRoot": "tools/swarmery/web/src/components",
    "routesRoot": "tools/swarmery/web/src/pages",
    "devUrl": "http://localhost:5173",
    "devCommand": "cd tools/swarmery && make dev",
    "fontLoader": "link-tag",
    "verify": {
      "lint": "cd tools/swarmery/web && npm run lint",
      "typecheck": "cd tools/swarmery/web && npx tsc --noEmit"
    }
  },
  "learning": { "areaDepth": 4 },
  "jira": {
    "baseUrl": "https://nanitor.atlassian.net",
    "projectKey": "NAN",
    "qaStatus": "QA",
    "repro": { "setup": "npm ci", "test": "npm test" },
    "budget": { "maxFiles": 5, "maxAttempts": 3 }
  }
}
