{
  "env": {
    "AGENT_PROJECT": "swarmery"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $CLAUDE_PROJECT_DIR/plugins/core/statusline/statusline.sh"
  },
  "enabledPlugins": {
    "accounts-pack@swarmery": true,
    "architecture-pack@swarmery": true,
    "claude-eng-pack@swarmery": true,
    "core@swarmery": true,
    "design-pack@swarmery": true,
    "graft-pack@swarmery": true,
    "graphify-pack@swarmery": true,
    "lsp-pack@swarmery": true,
    "review-pack@swarmery": true,
    "web-pack@swarmery": true
  },
  "extraKnownMarketplaces": {
    "swarmery": {
      "source": {
        "source": "github",
        "repo": "atretyak1985/swarmery"
      }
    }
  }
}
